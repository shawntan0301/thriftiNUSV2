generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  bio                 String?
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime       @default(now())
  isAdmin             Boolean        @default(false)
  accounts            Account[]
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  listing             Listing[]
  messages            Message[]
  authoredReviews     Review[]       @relation("AuthoredReviews")
  receivedReviews     Review[]       @relation("ReceivedReviews")
  sessions            Session[]
  savedListings       Listing[]      @relation("SavedListings")
  filedReports        Report[]       @relation("FiledReports")
  filedProfileReports ProfileReport[]       @relation("FiledProfileReports")
  offersAsBuyer       Offer[]        @relation(fields: [], references: [])
}

model Listing {
  id            String         @id @default(cuid())
  title         String
  description   String
  price         Float
  createdAt     DateTime       @default(now())
  userId        String
  brand         String?
  condition     Condition
  dealMethods   DealMethod[]
  status        Status         @default(AVAILABLE)
  category      Category
  imageUrls     String[]
  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedBy       User[]         @relation("SavedListings")
  reports       Report[]
  offers        Offer[]        @relation("ListingOffers")
}

model Review {
  id           String   @id @default(cuid())
  content      String
  rating       Int
  createdAt    DateTime @default(now())
  authorId     String
  targetUserId String
  author       User     @relation("AuthoredReviews", fields: [authorId], references: [id], onDelete: Cascade)
  targetUser   User     @relation("ReceivedReviews", fields: [targetUserId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  buyerId   String
  sellerId  String
  listingId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  listing   Listing   @relation(fields: [listingId], references: [id])
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

model Report {
  id           String         @id @default(cuid())
  reporterId   String // Person filing the report
  reporteeId   String // person being reported
  listingId    String
  createdAt    DateTime       @default(now())
  reportType   ReportTopic[]
  bodyText     String
  reportStatus ReportStatus[]

  // Relations
  reporter User    @relation("FiledReports", fields: [reporterId], references: [id], onDelete: Cascade)
  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

}

model ProfileReport {
  id           String         @id @default(cuid())
  reporterId   String // Person filing the report
  reporteeId   String // person being reported
  createdAt    DateTime       @default(now())
  reportType   ReportTopic[]
  bodyText     String
  reportStatus ReportStatus[]

  // Relations
  reporter User    @relation("FiledProfileReports", fields: [reporterId], references: [id], onDelete: Cascade)


}

model Offer {
  id         String      @id @default(cuid())
  listingId  String
  buyerId    String
  amount     Float
  message    String?     
  status     OfferStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  listing    Listing     @relation("ListingOffers", fields: [listingId], references: [id], onDelete: Cascade)
  buyer      User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)

}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ReportStatus {
  OPEN
  CLOSED
}

enum ReportTopic {
  PHISHING_SCAMMER
  SUSPICIOUS_ACCOUNT
  AN_ITEM_I_SOLD
  AN_ITEM_I_BOUGHT
  CANCELLING_ON_DEAL
  SELLING_PROHIBITED_ITEM
  MISPRICED_LISTINGS
  OFFENSIVE_BEHAVIOUR_OR_CONTENT
  DUPLICATE_POSTS
  IRRELEVANT_KEYWORDS
  ITEMS_WRONGLY_CATEGORIZED
  SELLING_COUNTERFEIT_ITEMS
}



enum Condition {
  BRAND_NEW
  LIKE_NEW
  LIGHTLY_USED
  WELL_USED
  HEAVILY_USED
}

enum Status {
  AVAILABLE
  RESERVED
  SOLD
}

enum DealMethod {
  DECK
  COM
  FASS
  TERRACE
  BIZ
  UTOWN
  CDE 
  USC 
  VENTUS
  CLB
  PGP
  IT 
  SCIENCE
}

enum Category {
  ELECTRONICS
  FASHION
  BOOKS
  STATIONERY
  OTHERS
}
